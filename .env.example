# ——— Imprescindibles para recibir solicitudes ———

# URL pública (sin barra final). En Netlify, si falta, se usa la URL del sitio.
SITE_URL=https://www.ejemplo.es
# true SOLO en el lanzamiento: hasta entonces la web no se indexa en Google.
SITE_INDEXABLE=false

# Secreto para firmar enlaces de reserva y la sesión del panel (cadena aleatoria larga).
# Generar con: openssl rand -hex 32
APP_SECRET=

# Contraseña del panel privado (/panel). Larga y solo para la empresa.
PANEL_PASSWORD=

# Supabase (región UE). La clave service role SOLO en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Avisos por email con Resend (dominio verificado con SPF y DKIM).
RESEND_API_KEY=
EMAIL_FROM="Souto Pinturas y Proyectos <web@ejemplo.es>"
NOTIFY_EMAIL_TO=soutoproyectospinturas@gmail.com

# ——— Google Calendar (opcional, recomendado) ———
# Cuenta de servicio con acceso «Hacer cambios en eventos» al calendario de la empresa.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada en una línea, con \n en los saltos.
GOOGLE_PRIVATE_KEY=

# ——— Opcionales ———
# Panel con datos de ejemplo (solo lectura) mientras no hay base de datos.
PANEL_DEMO=false
# Antispam Cloudflare Turnstile (si se rellena, se exige en los formularios).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sal para el hash de IP (si falta, se usa APP_SECRET).
IP_HASH_SALT=
