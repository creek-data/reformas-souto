# URL pública (sin barra final). Se usa para canonical, sitemap y datos estructurados.
SITE_URL=https://www.ejemplo.es
# Poner a true SOLO en el lanzamiento: hasta entonces la web no se indexa.
SITE_INDEXABLE=false

# Supabase (región UE). La clave service role SOLO en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por email con Resend (dominio verificado con SPF, DKIM y DMARC).
RESEND_API_KEY=
EMAIL_FROM="Web Souto <web@ejemplo.es>"
NOTIFY_EMAIL_TO=soutoproyectospinturas@gmail.com

# Antispam opcional: Cloudflare Turnstile (si se rellena, se exige en los formularios).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sal para el hash de IP (cadena aleatoria larga).
IP_HASH_SALT=
